@model IEnumerable<UniversityCourseManager.Models.Specialty>

@{
    ViewData["Title"] = "Специалности";
    bool isAdmin = User.IsInRole("Admin");
    bool isStudent = User.IsInRole("Student");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="mt-2 mb-1">Специалности</h1>
        <p class="text-muted mb-0">
            Изберете специалност и разгледайте свързаните дисциплини.
        </p>
    </div>

    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-warning text-white">
            + Добави нова специалност
        </a>
    }
</div>

@foreach (var item in Model.OrderBy(x => x.Name))
{
    <div class="content-card mb-4 p-4">
        <div class="specialty-title-box mb-4">
            <h4 class="mb-0">@item.Name</h4>
        </div>

        <div class="row">
            <div class="col-md-9">
                <div class="credits-line mb-3">
                    Необходими избираеми кредити: @item.RequiredElectiveCredits
                </div>

                <p class="text-muted mb-0">
                    Специалността може да съдържа набор от задължителни и избираеми дисциплини,
                    които студентът може да разгледа и избере.
                </p>
            </div>

            <div class="col-md-3">
                <div class="d-flex flex-column gap-2 align-items-md-end align-items-start specialty-buttons mt-3 mt-md-0">
                    @if (isStudent)
                    {
                        <a asp-action="Courses"
                           asp-route-id="@item.Id"
                           class="btn btn-student-courses btn-sm">
                            Виж дисциплините
                        </a>
                    }

                    @if (isAdmin)
                    {
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-secondary btn-sm">
                            Детайли
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm text-white">
                            Редакция
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Изтрий
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}