@model UniversityCourseManager.Models.Specialty

@{
    ViewData["Title"] = "Create Specialty";
}

<h1>Create Specialty</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RequiredElectiveCredits" class="form-label"></label>
        <input asp-for="RequiredElectiveCredits" class="form-control" />
        <span asp-validation-for="RequiredElectiveCredits" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}