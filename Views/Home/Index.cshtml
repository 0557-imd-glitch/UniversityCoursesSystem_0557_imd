@model UniversityCourseManager.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Начало";
}

<div class="row g-4 mb-4">

    <div class="col-lg-8">
        <div class="content-card p-4 h-100">
            <h1 class="mb-3">
                Добре дошли в системата за учебни дисциплини
            </h1>

            <p class="text-muted mb-0">
                Платформа за преглед на специалности и дисциплини с вход за администратор и студент.
            </p>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="content-card p-4 h-100">

            <div class="text-muted mb-2">
                Активен потребител
            </div>

            <div class="fs-4 mb-3">
                @Model.UserEmail
            </div>

            @if (Model.IsAdmin)
            {
                <span class="badge specialty-badge">
                    Администратор
                </span>
            }
            else
            {
                <span class="badge specialty-badge">
                    Студент
                </span>
            }

        </div>
    </div>

</div>


@if (Model.IsAdmin)
{
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <a asp-controller="Specialties"
               asp-action="Index"
               class="dashboard-card-link">

                <div class="content-card p-4 h-100 dashboard-card">

                    <div class="text-muted mb-2">
                        Специалности
                    </div>

                    <div class="dashboard-number">
                        @Model.SpecialtiesCount
                    </div>

                </div>

            </a>
        </div>


        <div class="col-md-4">
            <a asp-controller="Courses"
               asp-action="Index"
               class="dashboard-card-link">

                <div class="content-card p-4 h-100 dashboard-card">

                    <div class="text-muted mb-2">
                        Дисциплини
                    </div>

                    <div class="dashboard-number">
                        @Model.CoursesCount
                    </div>

                </div>

            </a>
        </div>


        <div class="col-md-4">
            <a asp-controller="Courses"
               asp-action="Enrollments"
               class="dashboard-card-link">

                <div class="content-card p-4 h-100 dashboard-card">

                    <div class="text-muted mb-2">
                        Записвания
                    </div>

                    <div class="dashboard-number">
                        @Model.EnrollmentsCount
                    </div>

                </div>

            </a>
        </div>

    </div>
}


@if (Model.IsStudent)
{
    var requiredCredits = (int)(ViewBag.RequiredCredits ?? 1);
    var activeSpecialtyName = ViewBag.ActiveSpecialtyName as string ?? "Няма избрана специалност";
    var activeSpecialtyId = (int)(ViewBag.ActiveSpecialtyId ?? 0);

    var progress = (int)Math.Min(
        100,
        Math.Round((double)Model.MyTotalCredits / requiredCredits * 100)
    );

    var progressClass = progress >= 100 ? "progress-ok" : "progress-missing";

    <div class="row g-4 mb-4">

        <div class="col-lg-6">

            <div class="content-card p-4 h-100">

                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <h2 class="mb-0">
                        Моите кредити
                    </h2>

                    @if (activeSpecialtyId > 0)
                    {
                        <a asp-controller="Specialties"
                           asp-action="Index"
                           class="btn btn-outline-secondary btn-sm">
                            Смени специалност
                        </a>
                    }
                </div>

                <div class="text-muted mb-2">
                    Активна специалност
                </div>

                @if (activeSpecialtyId > 0)
                {
                    <a asp-controller="Specialties"
                       asp-action="Courses"
                       asp-route-id="@activeSpecialtyId"
                       class="fw-semibold mb-3 d-inline-block home-active-specialty-link">
                        @activeSpecialtyName
                    </a>
                }
                else
                {
                    <div class="fw-semibold mb-3">
                        @activeSpecialtyName
                    </div>
                }

                <div class="mb-2">
                    <strong>@Model.MyTotalCredits</strong> / @requiredCredits кредита
                </div>

                <div class="progress dashboard-progress mb-3">

                    <div class="progress-bar @progressClass"
                         role="progressbar"
                         style="width:@progress%"
                         aria-valuenow="@progress"
                         aria-valuemin="0"
                         aria-valuemax="100">

                        @progress%

                    </div>

                </div>

                <p class="text-muted mb-0">
                    Следете прогреса си по избираемите дисциплини за избраната специалност.
                </p>

            </div>

        </div>


        <div class="col-lg-6">

            <div class="content-card p-4 h-100 d-flex flex-column">

                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                    <h2 class="mb-0">
                        Записани дисциплини
                    </h2>

                    @if (activeSpecialtyId > 0)
                    {
                        if (progress < 100)
                        {
                            <a asp-controller="Specialties"
                               asp-action="Courses"
                               asp-route-id="@activeSpecialtyId"
                               class="btn btn-student-courses btn-sm">
                                Избери дисциплини
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Specialties"
                               asp-action="Courses"
                               asp-route-id="@activeSpecialtyId"
                               class="btn btn-outline-secondary btn-sm">
                                Смени дисциплини
                            </a>
                        }
                    }
                </div>

                @if (ViewBag.EnrolledCourses != null && ((IEnumerable<dynamic>)ViewBag.EnrolledCourses).Any())
                {
                    foreach (var course in (IEnumerable<dynamic>)ViewBag.EnrolledCourses)
                    {
                        <div class="d-flex justify-content-between align-items-start py-2 border-bottom">

                            <div>
                                <div class="fw-semibold">
                                    @course.Name
                                </div>

                                <div class="text-muted small">
                                    @course.SpecialtyName
                                </div>
                            </div>

                            <span class="badge course-credit-badge">
                                @course.Credits кр.
                            </span>

                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">
                        Все още няма записани дисциплини.
                    </p>
                }

            </div>

        </div>

    </div>
}